      "description": "Persistent horizontal page navigation.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-control ds-tab ds-active\" aria-current=\"page\">Updates</button><button class=\"ds-control ds-tab\">History</button><button class=\"ds-control ds-tab\">Settings</button></nav>",
      "css": ".ds-control{font:500 13px 'Segoe UI Variable','Segoe UI',sans-serif;cursor:pointer;transition:background .14s ease-out,color .14s ease-out,border-color .14s ease-out}.ds-control:active{filter:brightness(.93)}.ds-control:focus-visible{outline:2px solid var(--accent,#7fc9ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none}}.ds-nav{display:flex;gap:18px;height:54px;border-bottom:1px solid var(--border,#31404d)}.ds-tab{position:relative;padding:0 16px;border:0;background:none;color:var(--muted,#a6b9cc);font-size:14px}.ds-tab:hover{background:var(--surface,#18232d);color:var(--text,#edf4fb)}.ds-active{color:var(--accent,#7fc9ff)}.ds-active:after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;border-radius:2px 2px 0 0;background:var(--accent,#7fc9ff)}"
    },
    {
      "name": "Selected filter",
      "kind": "chip",
      "refersTo": "filter-selected",
      "description": "Pressed category filter.",
      "html": "<button class=\"ds-control ds-filter\" aria-pressed=\"true\">All</button>",
      "css": ".ds-control{font:500 13px 'Segoe UI Variable','Segoe UI',sans-serif;cursor:pointer;transition:background .14s ease-out,color .14s ease-out,border-color .14s ease-out}.ds-control:active{filter:brightness(.93)}.ds-control:focus-visible{outline:2px solid var(--accent,#7fc9ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none}}.ds-filter{min-height:32px;padding:7px 14px;border:1px solid var(--accent-strong,#1479c7);border-radius:999px;font-size:12px;background:var(--accent-strong,#1479c7);color:#fff}.ds-filter:hover{background:var(--accent-strong,#1479c7)}"
