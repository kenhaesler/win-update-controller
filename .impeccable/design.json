      "css": ".ds-summary{background:var(--surface,#18232d);color:var(--text,#edf4fb);padding:20px;border-radius:6px;font-family:'Segoe UI Variable','Segoe UI',sans-serif}.ds-summary h2{font-size:16px;font-weight:600;margin:0 0 8px}.ds-summary p{font-size:13px;line-height:1.6;margin:0}"
