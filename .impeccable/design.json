      "css": ".ds-control{font:500 13px 'Segoe UI Variable','Segoe UI',sans-serif;cursor:pointer;transition:background .14s ease-out,color .14s ease-out,border-color .14s ease-out}.ds-control:active{filter:brightness(.93)}.ds-control:focus-visible{outline:2px solid var(--accent,#7fc9ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none}}.ds-search{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border,#31404d);border-radius:5px;background:var(--base,#141c23);color:var(--muted,#a6b9cc)}.ds-input{min-width:0;width:100%;background:none;border:0;color:var(--text,#edf4fb)}.ds-input::placeholder{color:var(--muted,#a6b9cc)}.ds-input:hover{background:var(--surface,#18232d)}"
