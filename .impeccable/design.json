      "html": "<button class=\"ds-control ds-primary\">Download selected</button>",
      "css": ".ds-control{font:500 13px 'Segoe UI Variable','Segoe UI',sans-serif;cursor:pointer;transition:background .14s ease-out,color .14s ease-out,border-color .14s ease-out}.ds-control:active{filter:brightness(.93)}.ds-control:focus-visible{outline:2px solid var(--accent,#7fc9ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none}}.ds-primary{min-height:36px;border:1px solid transparent;border-radius:6px;padding:8px 15px;background:var(--accent,#7fc9ff);color:var(--button-text,#102435)}.ds-primary:hover{background:color-mix(in srgb,var(--accent,#7fc9ff) 87%,var(--text,#edf4fb))}"
    },
